{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/no-casual-deploy.mjs\"",
            "if": "Bash(*deploy*)",
            "timeout": 10,
            "statusMessage": "Checking the deploy"
          }
        ]
      }
    ]
  }
}
