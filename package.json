{
  "name": "chess-problems",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "mkdir -p public/stockfish && cp node_modules/stockfish/bin/stockfish-18-lite-single.js node_modules/stockfish/bin/stockfish-18-lite-single.wasm node_modules/stockfish/bin/stockfish-18-lite.js node_modules/stockfish/bin/stockfish-18-lite.wasm public/stockfish/",
    "dev": "vite",
    "prebuild": "mkdir -p public/stockfish && cp node_modules/stockfish/bin/stockfish-18-lite-single.js node_modules/stockfish/bin/stockfish-18-lite-single.wasm node_modules/stockfish/bin/stockfish-18-lite.js node_modules/stockfish/bin/stockfish-18-lite.wasm public/stockfish/",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-api.mjs https://chess-problems.pages.dev",
    "smoke:staging": "node scripts/smoke-api.mjs https://chess-problems-staging.pages.dev",
    "deploy": "node scripts/no-casual-deploy.mjs --cli && npm run build && npx wrangler pages deploy dist --project-name=chess-problems && npm run smoke",
    "deploy:staging": "node scripts/no-casual-deploy.mjs --cli staging && npm run build && cp wrangler.toml wrangler.toml.bak && cp wrangler-staging.toml wrangler.toml && (npx wrangler pages deploy dist --project-name=chess-problems-staging; s=$?; mv wrangler.toml.bak wrangler.toml; exit $s) && npm run smoke:staging",
    "daily-post": "node scripts/generate-daily-post.mjs",
    "daily-post:week": "node scripts/generate-weekly-daily-posts.mjs",
    "daily-post:install": "node scripts/install-daily-post-launch-agent.mjs",
    "fetch-data": "tsx scripts/fetch-problems.ts",
    "test:parser": "tsx scripts/parser-regression.ts",
    "test:move-input": "tsx scripts/move-input-regression.ts",
    "feedback": "node scripts/read-feedback.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "chess.js": "^1.0.0-beta.8",
    "react": "^19.2.0",
    "react-chessboard": "^4.7.2",
    "react-dom": "^19.2.0",
    "stockfish": "^18.0.5",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
